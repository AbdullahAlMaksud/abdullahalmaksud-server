        {
          "name": "Sign In with Email OTP (POST /api/auth/sign-in/email-otp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('bearerToken', json.token); }",
                  "const authHeader = pm.response.headers.get('set-auth-token');",
                  "if (authHeader) { pm.collectionVariables.set('bearerToken', authHeader); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
