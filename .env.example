# ==============================================================================
# 1. SHARED CONFIGURATION & SECRETS (Both Local & Production)
# ==============================================================================

# Database configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# BetterAuth Security Secrets & Admin
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=your_email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Vercel Blob Storage Configuration
BLOB_STORE_ID=store_xxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
BLOB_BASE_URL=https://xxxxxxxxxxxx.public.blob.vercel-storage.com



# ==============================================================================
# 2. LOCAL DEVELOPMENT ENVIRONMENT (Active on Local Machine)
# ==============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
REQUIRE_DATABASE_CONNECTION=false
CORS_ORIGIN=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:4000
MONGODB_DB_NAME=abdullahalmaksud_dev


# ==============================================================================
# 3. PRODUCTION DEPLOYMENT ENVIRONMENT (Set on Vercel Dashboard / Live Server)
# ==============================================================================

# NODE_ENV=production
# HOST=0.0.0.0
# PORT=4000
# REQUIRE_DATABASE_CONNECTION=true
# CORS_ORIGIN=https://abdullahalmaksud.com
# GOOGLE_REDIRECT_URI=https://abdullahalmaksud.com/api/auth/callback/google
# BETTER_AUTH_URL=https://api-abdullahalmaksud.vercel.app
# MONGODB_DB_NAME=abdullahalmaksud
# COOKIE_DOMAIN=.abdullahalmaksud.com
