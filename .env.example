# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Duplicate this file as .env for local development or .env.production for production.
# IMPORTANT: Never commit actual secret keys or credentials to Git!
# ==============================================================================

# Server Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=abdullahalmaksud_dev
REQUIRE_DATABASE_CONNECTION=false

# Authentication & Security (BetterAuth)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5000
ADMIN_EMAILS=admin@example.com
COOKIE_DOMAIN=

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback/google

# Email Service (Resend OTP & Contact Inquiries)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Abdullah Al Maksud Admin <onboarding@resend.dev>
CONTACT_RECIPIENT_EMAIL=contact@example.com

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
