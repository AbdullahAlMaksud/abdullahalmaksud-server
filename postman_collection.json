    {
      "name": "4. Blog Posts (CRUD)",
      "description": "Full CRUD API for blog posts. Public GET endpoints, Admin-only POST/PUT/DELETE. Supports pagination (?page=1&limit=10) and published filter (?published=true).",
      "item": [
        {
          "name": "Get All Blog Posts (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/blogs?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blogs"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (default: 10, max: 50)"
                },
                {
                  "key": "published",
                  "value": "true",
                  "description": "Filter only published posts",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieves paginated list of all blog posts from MongoDB. Use ?published=true to filter only published posts."
          }
        },
        {
          "name": "Get Blog Post by Slug (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/blogs/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blogs", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "why-i-build-local-first-apps",
                  "description": "Unique blog post slug"
                }
              ]
            },
            "description": "Retrieves a single blog post by its unique slug."
          }
        },
        {
          "name": "Create Blog Post (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"নতুন ব্লগ পোস্ট\",\n  \"slug\": \"new-blog-post\",\n  \"content\": \"# শিরোনাম\\n\\nব্লগ পোস্টের বিস্তারিত কন্টেন্ট এখানে লিখুন। Markdown সাপোর্টেড।\\n\\n## সাব-হেডিং\\n\\n- পয়েন্ট ১\\n- পয়েন্ট ২\\n- পয়েন্ট ৩\",\n  \"excerpt\": \"এটি একটি নতুন ব্লগ পোস্টের সংক্ষিপ্ত বিবরণ।\",\n  \"coverImage\": \"/images/blog/new-post.png\",\n  \"author\": \"Abdullah Al Maksud\",\n  \"tags\": [\"javascript\", \"tutorial\", \"web\"],\n  \"category\": \"Tutorial\",\n  \"isPublished\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/blogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blogs"]
            },
            "description": "Creates a new blog post in MongoDB. Requires active Admin session. Slug must be unique. If isPublished=true, publishedAt is auto-set."
          }
        },
        {
          "name": "Update Blog Post (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"আপডেটেড ব্লগ টাইটেল\",\n  \"content\": \"# আপডেটেড কন্টেন্ট\\n\\nব্লগ পোস্টের আপডেটেড কন্টেন্ট।\",\n  \"isPublished\": true,\n  \"tags\": [\"updated\", \"blog\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/blogs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blogs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "BLOG_MONGO_ID_HERE",
                  "description": "MongoDB _id of the blog post"
                }
              ]
            },
            "description": "Updates an existing blog post by its MongoDB _id. Requires active Admin session. Supports partial updates."
          }
        },
        {
          "name": "Delete Blog Post (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/blogs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blogs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "BLOG_MONGO_ID_HERE",
                  "description": "MongoDB _id of the blog post"
                }
              ]
            },
            "description": "Deletes a blog post by its MongoDB _id. Requires active Admin session."
          }
        }
      ]
    },
