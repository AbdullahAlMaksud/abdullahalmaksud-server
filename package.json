{
  "name": "abdullahalmaksudserver",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:build": "tsc --noEmit",
    "test:lint": "eslint .",
    "test:commit": "echo feat: test message | npx commitlint",
    "test": "pnpm run test:build && pnpm run test:lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@vercel/blob": "^2.4.1",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "resend": "^6.26.0",
    "zod": "^4.4.3"
  }
}
